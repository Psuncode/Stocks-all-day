# Optional: enables Gemini explanations (server-side only).
GEMINI_API_KEY=

# Optional: override model name.
# Examples: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Slack webhook for invalidation alerts (see specs/swing-mvp-2026-06/requirements.md §C.2)
SLACK_WEBHOOK_URL=

# Bearer token for Vercel Cron (required in production)
CRON_SECRET=

# Account equity for suggested-shares hint on /symbol pages
ACCOUNT_EQUITY_USD=33000

# Public app URL for Slack message links (e.g. https://trader.psunproduction.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional override for watchlist file location
# WATCHLIST_PATH=data/watchlist.yaml

# FRED macro data API key (https://fred.stlouisfed.org/docs/api/api_key.html)
# Optional — when unset, the macro context strip is hidden.
FRED_API_KEY=
